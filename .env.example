# Nothing here is read unless the flags below are 1.
FLY_RH_LIVE=0
FLY_ALLOW_BROWSER=0

# The fly's Robinhood Chain wallet. Created by `py rhwallet.py new`.
# Never paste a live key into a chat window - anything pasted there is burned.
FLY_RH_SECRET=

FLY_RH_RPC=https://rpc.mainnet.chain.robinhood.com
FLY_RH_PAIR=GOOGL
FLY_RH_TAX=1
FLY_RH_X=

# Which brain. Her graph is the default; the male build is build/graph.npz.
FLY_GRAPH=build/graph_female.npz

# Optional: publish state and frames to the relay Worker in site/relay/
# instead of a local tunnel. Leave empty to read the rig directly.
FLY_RELAY_URL=
FLY_RELAY_TOKEN=

# Site (site/wrangler.toml [vars]) - set at launch, from the receipt.
# FLY_TOKEN=
# FLY_WALLET=
# FLY_TOKEN_BLOCK=0x0
# FLY_PAIR=GOOGL
# FLY_TAX_PCT=1
